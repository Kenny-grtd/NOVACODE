# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.

# --- Base de datos ---
POSTGRES_USER=novacode
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=novacode
DATABASE_URL=postgresql://novacode:cambia_esta_contrasena@db:5432/novacode

# --- Seguridad (JWT) ---
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Correo (notificaciones) ---
# Usa una contraseña de aplicación, no tu contraseña normal.
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- General ---
EMPRESA_NOMBRE=NOVACODE
